    "def sales_category(x):\n",
    "    if x>500:\n",
    "        return \"High Sales\"\n",
    "    elif x >=100:\n",
    "        return \"Medium sale\"\n",
    "    else:\n",
    "        return \"Low Sales\"\n",
    "df[\"Sales Category\"]=df[\"Sales\"].apply(sales_category)\n",
    "df.head(10)"
   ]
  },
